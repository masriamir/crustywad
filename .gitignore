# Compiled output / build artifacts
/target/
**/target/

# Cargo.lock is intentionally COMMITTED: this workspace ships a binary (CLI).
# (Do not ignore Cargo.lock.)

# Backup files from rustfmt / editors
**/*.rs.bk
*.orig

# MSVC debug info (Windows)
*.pdb

# Coverage output (cargo-llvm-cov / grcov)
*.profraw
*.profdata
/lcov.info
/coverage/

# Fuzzing (cargo-fuzz)
/fuzz/target/
# fuzz/ is a separate dev-only workspace; its lock is regenerated by `cargo fuzz`
# (CI runs without `--locked`) and has never been committed — keep it local-only.
/fuzz/Cargo.lock
# Auto-generated corpus entries from libFuzzer (hex-named); seed corpus files are committed
fuzz/corpus/*/[0-9a-f][0-9a-f]*
/fuzz/artifacts/
/fuzz/coverage/

# mdbook-mermaid generated assets (produced by `mdbook-mermaid install`; generated at build time, not committed)
docs/guide/mermaid.min.js
docs/guide/mermaid-init.js

# Downloaded FreeDoom WAD fixtures (fetched locally & in CI, never committed)
/tests/fixtures/freedoom/
/crates/crustywad/tests/fixtures/freedoom/

# Local IWAD/PWAD blobs dropped at the repo root (supplied locally for optional
# hexen-tests / doom64-tests / ad-hoc inspection — WAD blobs are never committed)
/*.wad
/*.WAD

# Local retail WAD collection (fixture source for the optional sweep/fixture
# tests — retail blobs are never committed)
/PWADS/

# Local extended-node WAD collection (ZDBSP-derived Freedoom variants for the
# gate-expecting sweep, #269 — regenerable, never committed)
/PWADS-EXT/

# Benchmark output
/criterion/

# Environment / local overrides
.env
.env.local

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary files
/.tmp/

# Claude Code agent worktrees (ephemeral, created by Claude Code)
.claude/worktrees/

# Ad-hoc local git worktrees (not tracked by Claude Code)
.worktrees/

# AI agent artifacts (superpowers plans, memory files — never committed)
docs/superpowers/

# Python bytecode caches (the docs-sync scripts are imported by ad-hoc checks,
# which makes CPython write these next to the sources)
__pycache__/
*.py[cod]
