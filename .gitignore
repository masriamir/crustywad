# Shared ignores are block-synced from masriamir/.github (see .meta-manifest.toml,
# `just meta-check`). Edit the canonical source upstream, not inside the markers.
# >>> meta:gitignore-rust
# Compiled output / build artifacts
/target/
**/target/

# Backup files from rustfmt / editors
**/*.rs.bk
*.orig

# MSVC debug info (Windows)
*.pdb

# Coverage output (cargo-llvm-cov / grcov)
*.profraw
*.profdata
/lcov.info
/coverage/
# <<< meta:gitignore-rust

# Cargo.lock is intentionally COMMITTED: this workspace ships a binary (CLI).
# (Do not ignore Cargo.lock.)

# >>> meta:gitignore-base
# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Environment / local overrides
.env
.env.local

# Python bytecode caches
__pycache__/
*.py[cod]

# Temporary files
/.tmp/

# Claude Code agent worktrees (ephemeral, created by Claude Code)
.claude/worktrees/

# Ad-hoc local git worktrees
.worktrees/

# AI agent artifacts (superpowers plans/specs — never committed)
docs/superpowers/

# Playwright MCP browser-session artifacts
.playwright-mcp/
# <<< meta:gitignore-base

# ─── crustywad-specific ──────────────────────────────────────────────────────

# Fuzzing (cargo-fuzz)
/fuzz/target/
# fuzz/ is a separate dev-only workspace; its lock is regenerated by `cargo fuzz`
# (CI runs without `--locked`) and has never been committed — keep it local-only.
/fuzz/Cargo.lock
# Auto-generated corpus entries from libFuzzer (40-hex-char SHA-1 names); the
# glob requires eight leading hex digits so committed seed files stay tracked
# (two digits matched the `d64_trailer.bin` seed and broke release-plz, which
# refuses to run while a committed file is also gitignored). Keep seed names
# from starting with eight hex characters (`seed_*`, `d64_*`, `multi_*` are
# all safe — each breaks the run well before the eighth character).
fuzz/corpus/*/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*
/fuzz/artifacts/
/fuzz/coverage/

# idgames harvest tool (ADR-0030): every output and the response cache live
# under xtask/data/, and nothing generated is ever committed — the PII
# posture depends on it. (xtask/Cargo.lock, unlike fuzz's, IS committed:
# it is a binary tool, and the dependency audit wants the lockfile.)
/xtask/data/

# mdbook-mermaid generated assets (produced by `mdbook-mermaid install`; generated at build time, not committed)
docs/guide/mermaid.min.js
docs/guide/mermaid-init.js

# Downloaded FreeDoom WAD fixtures (fetched locally & in CI, never committed)
/tests/fixtures/freedoom/
/crates/crustywad/tests/fixtures/freedoom/

# Local IWAD/PWAD blobs dropped at the repo root (supplied locally for optional
# hexen-tests / doom64-tests / ad-hoc inspection — WAD blobs are never committed)
/*.wad
/*.WAD

# Local retail WAD collection — mixed IWAD/PWAD magic: retail IWADs plus their
# BFG/KEX/SVE companion PWADs (fixture source for the optional sweep/fixture
# tests — retail blobs are never committed)
/RETAIL/

# Local extended-node WAD collection (ZDBSP-derived Freedoom variants for the
# gate-expecting sweep, #269 — regenerable, never committed)
/RETAIL-EXT/

# Local pk3 collection (fixture source for the optional pk3-tests, #445 —
# archive blobs are never committed)
/PK3-EXT/

# Benchmark output
/criterion/
